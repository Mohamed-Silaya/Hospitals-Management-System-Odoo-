<odoo>
    <record id="view_hms_patient_form" model="ir.ui.view">
        <field name="name">hms.patient.form</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <sheet>
                    <notebook>

                    <page string="Patient DATA">
                    <group string="patient data">
                        <field name="first_name"/>
                        <field name="last_name"/>
                        <field name="email" />
                        <field name="birth_date"/>
                        <field name="age"/>
                        <field name="history"/>
                        <field name="cr_ratio" required= "'pcr' == True"/>
                        <field name="blood_type"/>
                        <field name="pcr" modifiers="{'readonly': [('age', '&lt;', 50)]}" />
                        <field name="image" widget="image"/>
                        <field name="address"/>
                        <field name="department_id"/>
                        <field name="department_capacity"/>
                        <field name="doctor_ids" widget="many2many_tags"/>
<!--                         options="{'field': 'full_name'}"-->
                        <field name="state"/>
                    </group>
                    </page>

                      <!--                Logs view -->
                    <page string="Custom Logs">
                        <field name="log_history_ids" widget="one2many_list">
                            <tree>
                                <field name="create_date"/>
                                <field name="created_by"/>
                                <field name="description"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                </sheet>

            </form>
        </field>
    </record>

    <record id="view_hms_patient_tree" model="ir.ui.view">
        <field name="name">hms.patient.tree</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <tree string="Patients">
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="email"/>
                <field name="age"/>
                <field name="department_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_hms_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hms.patient</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
